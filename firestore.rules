rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Rooms: any signed-in user can read (needed so joining-by-code can check
    // a room exists before the user is a member). Only the creator can delete.
    // Anyone signed in can create a room (becomes the admin).
    match /rooms/{roomId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;

      // Updates are only allowed to join or leave: the only field that may
      // change is `members`, and a user may only add or remove their OWN uid
      // (can't touch other members, the name, createdBy, etc).
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && (
          (request.auth.uid in request.resource.data.members
            && !(request.auth.uid in resource.data.members))
          ||
          (!(request.auth.uid in request.resource.data.members)
            && request.auth.uid in resource.data.members)
        );

      // Subcollections (tasks, links, messages): only members of this room.
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
      }
    }
  }
}